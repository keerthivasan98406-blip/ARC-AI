{
  "manifest_version": 3,
  "name": "Arc AI Assistant",
  "version": "1.0.1",
  "description": "Arc AI floating assistant available on every Chrome tab, full screen videos, and LMS/PMS portals.",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "tabs",
    "scripting",
    "sidePanel",
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shield.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["shield.js", "icons/icon16.png", "icons/icon48.png", "icons/icon128.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "action": {
    "default_title": "Arc AI Assistant",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
